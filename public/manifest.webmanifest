{
  "id": "/",
  "name": "Games: party and drinking games",
  "short_name": "Games",
  "description": "Free party and drinking games: pass one phone round, or everyone on their own phone with a room code and a TV screen.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "portrait",
  "background_color": "#0b0812",
