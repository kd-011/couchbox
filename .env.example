# Copy to .env and edit. Every variable is optional. The server reads .env at
# startup and never overrides a variable already set in the environment.

# Port to listen on (default 8969).
GAMES_PORT=8969
# Address to bind (default 127.0.0.1, so only a local reverse proxy can reach it).
# Use 0.0.0.0 inside a container.
GAMES_HOST=127.0.0.1

# Public URL of your site, no trailing slash. Used for canonical links, the
# sitemap, share cards and QR codes. Unset, it is read from each request's Host header.
# GAMES_SITE_URL=https://games.example.com
# Address shown on the privacy and credits pages. Set this if you host a copy.
# GAMES_CONTACT_EMAIL=you@example.com

# Where custom and AI-made packs are saved (default ~/.local/share/games-packs).
# GAMES_PACKS_DIR=/var/lib/games-packs

# AI pack maker ("make me a pack about X"). Off without a key.
# OPENROUTER_API_KEY=
# GAMES_AI_PACK_MODEL=google/gemini-3.8-flash
# GAMES_AI_PACK_DAILY_CAP_USD=0.5
# Sent to OpenRouter as HTTP-Referer when set.
# GAMES_AI_REFERER=

# Host Box voice lines through a Kokoro TTS server. Off if it is unreachable.
# KOKORO_SERVER_URL=http://127.0.0.1:8124
# HOSTBOX_VOICE=af_sky
# HOSTBOX_VOICE_SPEED=1.0

# Development only. Never set these in production.
# GAMES_EXAMPLE=1       also list the High Card example game
# GAMES_TEST_HOOKS=1    expose /__test/ hooks used by e2e/matrix.mjs
# GAMES_CANARY_URL=     base URL the nightly canary (npm run canary) plays against
# E2E_OUT=/tmp/games-e2e
