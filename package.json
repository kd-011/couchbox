{
  "name": "games",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Games: free party and drinking games, pass-and-play or everyone on their own phone.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "party-games": "bin/party-games.mjs"
  },
  "files": [
    "bin",
    "lib",
    "public",
    "games",
    "!games/**/*.test.mjs",
    "server.mjs",
    ".env.example",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "start": "node server.mjs",
    "lan": "node server.mjs --lan",
    "test": "node --test 'test/**/*.test.mjs' 'games/**/*.test.mjs'",
    "e2e": "node e2e/play.mjs",
    "canary": "node e2e/canary.mjs",
    "plays": "node lib/plays.mjs",
    "deps": "npm ci --no-audit --no-fund",
    "scan": "node scripts/secret-scan.mjs . --tracked",
    "export": "node scripts/export-public.mjs"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
